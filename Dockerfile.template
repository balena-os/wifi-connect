# ---- Rust build stage ----
FROM rust:1.76-bullseye AS rust-build

RUN apt-get update && apt-get install -y --no-install-recommends \
    libdbus-1-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY src ./src

RUN cargo build --release

# ---- UI build stage ----
FROM node:16-bullseye-slim AS ui-build

WORKDIR /build

COPY ui/package.json ui/package-lock.json ./
RUN npm ci

COPY ui/public ./public
COPY ui/src ./src
COPY ui/tsconfig.json ./
RUN npm run build

# ---- Runtime stage ----
FROM debian:bullseye

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    dnsmasq \
    wireless-tools \
    network-manager \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY --from=rust-build /build/target/release/wifi-connect ./
COPY --from=ui-build /build/build ./ui

COPY scripts/start.sh .

CMD ["bash", "start.sh"]
